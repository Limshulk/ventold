{
    "search.exclude": {
        "**/build": true
    },
    "cmake.configureOnOpen": true,
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.copyCompileCommands": "${workspaceFolder}/build/compile_commands/compile_commands.json",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands/compile_commands.json",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build/compile_commands",
        "--header-insertion=never"
    ]
}